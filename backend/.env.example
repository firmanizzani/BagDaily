NODE_ENV=development
PORT=3000

# Supabase pooled connection for runtime (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Auth secrets
JWT_SECRET=replace_with_a_secure_random_secret_generated_from_64_bytes
SESSION_COOKIE_NAME=bagdaily_session
# SESSION_COOKIE_DOMAIN is optional. Leave unset to use a host-only cookie.

# CORS / Origin validation
FRONTEND_URL=http://localhost:5173

# Business settings
PAYMENT_TIMEOUT_MINUTES=15

# Private Supabase Storage buckets for product images and user profile photos.
# Backend serves catalog images publicly and profile photos to their signed-in owner.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

SUPABASE_PROFILE_STORAGE_BUCKET=profile-images
