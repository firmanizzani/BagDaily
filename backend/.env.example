NODE_ENV=development
PORT=3000

# Supabase direct connection for migrations (session mode, port 5432)
DATABASE_MIGRATION_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase pooled connection for runtime (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Auth secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_characters
SESSION_COOKIE_NAME=bagdaily_session
SESSION_COOKIE_DOMAIN=

# CORS / Origin validation
FRONTEND_URL=http://localhost:5173

# Business settings
PAYMENT_TIMEOUT_MINUTES=15

# Private Supabase Storage buckets for product images and user profile photos.
# Backend serves catalog images publicly and profile photos to their signed-in owner.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_PROFILE_STORAGE_BUCKET=profile-images

# Demo accounts (no defaults in code; set these to run seed demo accounts)
DEMO_ADMIN_PASSWORD=
DEMO_CASHIER_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# Bounded pool for concurrent catalog/dashboard requests
DATABASE_POOL_SIZE=4
